{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "harbor-desk",
	"main": "src/server.ts",
	"compatibility_date": "2026-10-12",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vars": {
		"WEBHOOK_TOKEN": "harbor-demo"
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/agents/*", "/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "DeskAgent",
				"class_name": "DeskAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DeskAgent"]
		}
	]
}
